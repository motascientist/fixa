<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema escuro: é ele que faz o app (prefers-color-scheme) acompanhar o modo escuro do celular. -->
    <style name="Tema" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">@bool/claro</item>
        <item name="android:windowLightNavigationBar">@bool/claro</item>
    </style>
</resources>
